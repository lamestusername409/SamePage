rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isReader() {
      return request.auth != null &&
        request.auth.token.email in ["dogmomandrea@gmail.com", "alli-mills@sbcglobal.net"];
    }
    match /{document=**} {
      allow read, write: if isReader();
    }
  }
}
